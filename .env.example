# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# Estes valores são públicos (usados no browser); a proteção dos dados é feita por RLS.
# Nunca coloque aqui a service_role key ou a senha do banco.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
